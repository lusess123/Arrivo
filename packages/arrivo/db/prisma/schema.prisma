generator clientWorker {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-worker"
  moduleFormat = "esm"
  runtime      = "cloudflare"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  userName         String
  nickname         String?
  email            String?
  phoneNumber      String?
  wechatId         String?
  remarkInfo       String?
  lastLoginTime    DateTime?
  lastLogoutTime   DateTime?
  registrationTime DateTime
  companyName      String?
  openId           String?    @default("")
  headimgurl       String?
  newUser          Boolean?
  access           String?
  voice            String?    @db.VarChar(20)
  speed            Int        @default(0)
  is_delayed       Boolean?
  is_public        Boolean?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedBy        String?    @db.Uuid
  createdBy        String?    @db.Uuid
  updatedBy        String?    @db.Uuid
  tenantId         String     @default("helloworld") @db.VarChar(50)
  teamId           String?    @db.Uuid
  env              String?    @db.VarChar(50)
  Articles         Articles[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, email])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

model Articles {
  id        String      @id @default(uuid(7)) @db.Uuid
  content   String?
  title     String?
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedBy String?     @db.Uuid
  createdBy String?     @db.Uuid
  updatedBy String?     @db.Uuid
  tenantId  String      @default("helloworld") @db.VarChar(50)
  teamId    String?     @db.Uuid
  env       String?     @db.VarChar(50)
  userId    String?     @db.Uuid
  isPublic  Boolean     @default(false)
  playCount Int         @default(0)
  user      User?       @relation(fields: [userId], references: [id])
  Sentences Sentences[]

  @@unique([tenantId, userId, title])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, isPublic, createdAt])
  @@index([tenantId, deletedAt])
}

model Sentences {
  id                String      @id @default(uuid(7)) @db.Uuid
  content           String?
  articleId         String?     @db.Uuid
  article           Articles?   @relation(fields: [articleId], references: [id])
  originalContent   String?
  translatedContent String?
  languageCode      String      @default("en") @db.VarChar(10)
  sentenceGroupId   String      @db.Uuid
  sortOrder         Int         @default(0)
  parentSentenceId  String?     @db.Uuid
  parentSentence    Sentences?  @relation("SentenceChildren", fields: [parentSentenceId], references: [id], onDelete: Cascade)
  children          Sentences[] @relation("SentenceChildren")
  splitStatus       String      @default("UNKNOWN") @db.VarChar(20)
  splitAnalyzedAt   DateTime?
  splitModel        String?     @db.VarChar(100)
  splitVersion      String?     @db.VarChar(50)
  playCount         Int         @default(0)
  playedWordIndexes Int[]       @default([])
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedBy         String?     @db.Uuid
  createdBy         String?     @db.Uuid
  updatedBy         String?     @db.Uuid
  tenantId          String      @default("helloworld") @db.VarChar(50)
  teamId            String?     @db.Uuid
  env               String?     @db.VarChar(50)

  @@index([tenantId, articleId, createdAt])
  @@index([tenantId, articleId, sortOrder])
  @@index([tenantId, articleId, languageCode, sortOrder])
  @@index([tenantId, sentenceGroupId, languageCode])
  @@index([tenantId, parentSentenceId, sortOrder])
  @@index([tenantId, deletedAt])
}

model Config {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String
  value       String
  description String?
  appName     String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedBy   String?   @db.Uuid
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  tenantId    String    @default("helloworld") @db.VarChar(50)
  teamId      String?   @db.Uuid
  env         String?   @db.VarChar(50)

  @@unique([tenantId, key])
  @@index([tenantId, deletedAt])
}

model UserPassword {
  id        String    @id @default(uuid(7)) @db.Uuid
  password  String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedBy String?   @db.Uuid
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  tenantId  String    @default("helloworld") @db.VarChar(50)
  teamId    String?   @db.Uuid
  env       String?   @db.VarChar(50)

  @@index([tenantId, deletedAt])
}

model PhoneCode {
  id            String    @id @default(uuid(7)) @db.Uuid
  code          String?
  userId        String?   @db.Uuid
  expiredTime   DateTime?
  toPhoneNumber String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedBy     String?   @db.Uuid
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  tenantId      String    @default("helloworld") @db.VarChar(50)
  teamId        String?   @db.Uuid
  env           String?   @db.VarChar(50)

  @@index([tenantId, toPhoneNumber, createdAt])
  @@index([tenantId, deletedAt])
}

model EmailCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  code        String?
  purpose     String?   @db.VarChar(40)
  userId      String?   @db.Uuid
  expiredTime DateTime?
  toEmail     String?
  usedAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedBy   String?   @db.Uuid
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  tenantId    String    @default("helloworld") @db.VarChar(50)
  teamId      String?   @db.Uuid
  env         String?   @db.VarChar(50)

  @@index([tenantId, code, purpose])
  @@index([tenantId, toEmail, purpose, createdAt])
  @@index([tenantId, toEmail, createdAt])
  @@index([tenantId, deletedAt])
}

enum MindTaskStatus {
  IN_PROGRESS
  WAITING
  PAUSED
  DONE
}

enum MindNoteType {
  IDEA
  CONCERN
  INSPIRATION
  OTHER
}

model MindWorkspace {
  tenantId      String    @db.VarChar(50)
  userId        String    @db.Uuid
  currentTaskId String?   @db.Uuid
  revision      String    @db.Uuid
  currentTask   MindTask? @relation(fields: [tenantId, userId, currentTaskId], references: [tenantId, userId, id], onDelete: Restrict)

  @@id([tenantId, userId])
}

model MindTask {
  tenantId    String          @db.VarChar(50)
  userId      String          @db.Uuid
  id          String          @db.Uuid
  title       String
  status      MindTaskStatus  @default(IN_PROGRESS)
  lastContext String?
  nextAction  String?
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  focus       MindWorkspace[]
  notes       MindNote[]
  actions     MindAction[]

  @@id([tenantId, userId, id])
}

model MindNote {
  tenantId   String       @db.VarChar(50)
  userId     String       @db.Uuid
  id         String       @db.Uuid
  content    String
  type       MindNoteType @default(OTHER)
  taskId     String?      @db.Uuid
  setAside   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  task       MindTask?    @relation(fields: [tenantId, userId, taskId], references: [tenantId, userId, id], onDelete: Restrict)
  actions    MindAction[]

  @@id([tenantId, userId, id])
  @@index([tenantId, userId, taskId])
}

model MindAction {
  tenantId  String    @db.VarChar(50)
  userId    String    @db.Uuid
  id        String    @db.Uuid
  taskId    String?   @db.Uuid
  noteId    String?   @db.Uuid
  title     String
  done      Boolean   @default(false)
  dueOn     DateTime? @db.Date
  createdAt DateTime  @default(now())
  task      MindTask? @relation(fields: [tenantId, userId, taskId], references: [tenantId, userId, id], onDelete: Cascade)
  note      MindNote? @relation(fields: [tenantId, userId, noteId], references: [tenantId, userId, id], onDelete: Cascade)

  @@id([tenantId, userId, id])
  @@index([tenantId, userId, taskId])
  @@index([tenantId, userId, noteId])
}
